# Treasury Engine's own inbound API key — Swap/Transfer/Payment engines call
# Treasury endpoints with this key in X-Treasury-API-Key
TREASURY_ENGINE_API_KEY=

# Network selection — configurable so testnet can be enabled later without
# code changes. mainnet: chainId 56 / testnet: chainId 97.
BSC_CHAIN_ID=56
BSC_RPC_URLS=https://bsc-dataseed.binance.org/,https://bsc-dataseed1.defibit.io/,https://bsc.publicnode.com,https://rpc.ankr.com/bsc

# Treasury hot wallet — funds gas sponsorship top-ups. NEVER commit a real key.
# KNOWN GAP (see PRODUCTION_BLOCKERS.md): plain env var, not a KMS/HSM. Do not
# fund this wallet with more than you can afford to lose until that's fixed.
TREASURY_HOT_WALLET_PRIVATE_KEY=

# Fee policy
TREASURY_FEE_BPS=30
TREASURY_MIN_FEE_WEI=0

# Gas sponsorship policy
GAS_SPONSORSHIP_THRESHOLD_WEI=2000000000000000
GAS_SPONSORSHIP_TOPUP_WEI=3000000000000000
GAS_SPONSORSHIP_DAILY_CAP_WEI=50000000000000000

GITHUB_PACKAGES_TOKEN=
