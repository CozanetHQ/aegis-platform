# Shared Aegis engines Supabase project (Rule 2 — ONE project, own tables only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# This engine's own inbound API key — Identity/Transfer/Payment engines call
# Wallet Vault endpoints with this key in X-Vault-API-Key
WALLET_VAULT_API_KEY=
WALLET_VAULT_API_KEY_SWAP=

# HD custody root (MVP only — see README "Known gap": must move to real KMS/HSM
# before any mainnet funds are custodied. This is the single biggest security
# gap in this engine and is called out explicitly, not hidden.)
VAULT_HD_MNEMONIC=
VAULT_MASTER_KEY_HEX=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GITHUB_PACKAGES_TOKEN=
